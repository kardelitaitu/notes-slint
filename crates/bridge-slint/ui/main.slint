// S3 UI payload for the slint bridge: a title strip that can ask to be pinned,
// a status line the pump writes, and a deliberately dumb editor (the text<->Flush
// loop is S4). The four slint-1.17 findings from the out-of-tree spike are encoded
// here, each where it bites:
//  1. widgets are NOT builtins - TextEdit has to come from the style library.
//  2. Rectangle.color is deprecated; `background` is the current name.
//  3. a handler may not assign an `in` property ("Assignment on a input property"),
//     so anything the UI writes locally is declared `in-out`.
//  4. `export { X }` takes no trailing semicolon (the semicolon is a hard error).

import { TextEdit } from "std-widgets.slint";
// S2 owns the strip and the palette; this file only mounts them.
import { Chrome } from "chrome.slint";
import { Theme } from "theme.slint";

export component Spike inherits Window {
    // The file name in the title is a FACT the port reported (`Loaded`/`Rebound`
    // carry the path); the bridge never invents it, so it is one-way Event -> UI.
    // The OS title is a STRING THE BRIDGE BUILDS from the port's fact (see
    // `title_contract`), and Rust writes it on every arm - markup computes nothing.
    in property <string> os-title: "notes";
    in property <string> title-words: "Untitled";
    title: root.os-title;
    // R1 THE FRAME CONTRACT, flipped for real: no OS frame, so the strip below is the
    // only title bar and the only drag handle, and `resize-border-width` is what
    // leaves Slint a border to grab. The risk this is here to measure is that an
    // undecorated winit window loses WS_MAXIMIZEBOX, in which case the OS refuses
    // Win+Up and the port's restore has nothing to restore INTO.
    no-frame: true;
    resize-border-width: 8px;

    // R2: the close act, driven through the ONLY close door this build exposes.
    // `slint::Window` has no request_close(), so Rust cannot fire the request; the
    // Window builtin `close() -> bool` can be fired from markup, and a `changed`
    // callback is how Rust reaches it. Bumping `close-arm` runs close(), which runs
    // the close_requested handler registered in Rust (the same handler an OS close
    // reaches), and the bool it answered with lands in `close-allowed` for Rust to
    // read back. Declining is real: the window must still be visible afterwards.
    in property <int> close-arm: 0;
    out property <bool> close-allowed: false;
    changed close-arm => {
        // 1.17: inside a changed handler the Window builtins need a receiver - bare
        // close() is an unknown unqualified identifier, self.close() is the door.
        root.close-allowed = self.close();
    }

    // C1, and this line is the whole point: Slint's OWN always-on-top property is
    // never mentioned here and stays at its default. notes-platform, through the
    // port, is the single WS_EX_TOPMOST writer - so `pinned` below is a RENDER of
    // what the port reported, not a wish.
    in property <bool> pinned: false;
    in property <string> status: "starting";

    // S4b: THE THREE SIGNALS, now fed by the port through Rust instead of a constant.
    // Same rule as pinned above: each is a RENDER of an answer (or, for autosave, of the
    // last Command::SetAutosave this bridge sent, because the port echoes no event for
    // it), and markup computes nothing - dirty is buffer!=last_sent in main.rs, not here.
    in property <bool> dirty: false;
    in property <bool> save-failed: false;
    in property <bool> autosave: false;

    // The only thing the strip may decide by itself. `in-out`, per finding 3.
    in-out property <int> taps: 0;

    // Chrome's guess at what the click meant, recorded so the run can show it was
    // dropped on the way to the port. Nothing else reads it.
    in-out property <bool> asked-guess: false;

    // THE BUFFER, and the whole reason `in-out` is not a workaround: the port's text
    // lands here on a load, and every keystroke lands here too, so Rust reads one
    // property instead of reaching into a widget (architecture 5.5 - the bridge owns
    // the editor, api never sees a keystroke).
    in-out property <string> buffer;
    callback toggled-pin();

    // R1: the strip's double-click, which is what a frameless window has to offer in
    // place of the OS caption button. The handler lives in Rust (set_maximized is a
    // window call), and the markup only names the event.
    callback toggle-max();

    // S4c: THE MENU ROWS, forwarded - not answered. Chrome owns the look and the row's
    // identity, and it dismisses itself on a pick (its own in-out menu-open); what a row
    // DOES is decided in Rust, on the SAME path the chords and the native menu use, so a
    // click cannot grow a second set of rules about when the engine gets to write. The
    // names match Chrome's one-for-one for the same reason: a mapping, not a translation.
    callback open-asked();
    callback save-as-asked();
    callback autosave-asked();
    // S6: the 5th row, forwarded like the other four.
    callback clear-recents-asked();
    /// Quit is not a command: it closes the window, which is the only shutdown route
    /// that flushes and joins the engine (see the close contract in main.rs).
    callback quit-asked();

    // S5: THE DRAG, forwarded exactly like the double-click. Chrome carries the pointer's
    // DELTA - origin-independent, and the only geometry fact a title band is allowed to
    // know - plus the release. Turning a delta into a frame-inclusive target is drag_by()
    // in main.rs, and the port is asked to STORE a rect once per drag, on the drop, not
    // once per frame.
    callback drag-delta(length, length);
    callback drag-ended();

    // S7: the popup's three dismissal routes, exposed so an unattended run can drive the very
    // callbacks a hamburger click, a backdrop click and an Escape press reach. Chrome still
    // writes the state - these only carry the ask, and the mirrors above only read it.
    callback toggle-menu-asked();
    callback backdrop-asked();
    callback escape-asked();

    /// S10: TextEdit's own edited signal, forwarded unchanged. It carries NO text: the pump
    /// reads the buffer when it acts, not on every keystroke, which is the point of the event.
    callback text-edited();

    /// S10b: the quarantine's own signal - raised when a replay key is swallowed, so a run can
    /// SHOW the swallow instead of inferring it from an absence. It asks nothing: the key is
    /// already accepted by the time this fires, and the port is never told.
    callback undo-swallowed();

    /// S10: which document the editor is showing, in the bridge's own counting. Bumped at every
    /// adoption (Loaded and Rebound) and nothing else. It exists because 1.17 cannot clear a
    /// TextEdit's undo history (no such API exists - verified across the whole toolkit) and the
    /// only other answer is to destroy and recreate the widget; see the finding in src/main.rs
    /// for why that half is not shipped yet.
    in-out property <int> doc-generation: 0;

    /// S8: the caption minimize ask, carried up so Rust can answer it. Every other caption
    /// cell reused a door that already existed; this is the one that had to be added.
    callback minimize-requested();

    // ---- S5: recents, as delivered ----
    // `Event::RecentsUpdated(Vec<RecentEntry>)` has been arriving, unused, since S4.
    // `core` already decided the label (`display`), the cap and the missing-file mark,
    // so the bridge renders exactly what it was handed and keeps the paths in Rust -
    // a row is a row, and a path never needs to travel through the markup.
    // S7: READ-ONLY mirrors of what Chrome decided, so a live run can print it. Rust cannot
    // reach an element inside a component by id - that limitation has shaped every slice here -
    // but a property binding is not an access: these read Chrome's outputs and write nothing.
    // The single-writer claim survives precisely because the direction is one-way.
    in property <bool> menu-shown: chrome.menu-open;
    // S7: the probe two doors. Bumping a number is not writing Chrome state - Chrome
    // reacts to the change in its own handler, so menu-open keeps exactly one writer.
    in-out property <int> toggle-asks: 0;
    in-out property <int> close-asks: 0;
    in property <length> popup-x: chrome.popup-x;
    in property <bool> popup-floored: chrome.popup-floored;
    in property <bool> popup-overflow: chrome.popup-overflow;

    in property <[string]> recents;
    callback open-at-index(int);
    // Row height is a constant, and the layout is deliberately crude: this is a
    // spike list to prove the model binds and a click maps back to an index.
    // NOTE the names: plain `row` is refused - "Cannot override property 'row'",
    // because Rectangle already answers to a layout-attachment property of that
    // name. A fifth 1.17 finding, and the reason these are suffixed.
    property <length> row-h: 15px;
    property <length> stack-h: root.recents.length * root.row-h;

    // S6: THE CHORD SCOPE. The nesting IS the mechanism: capture-key-pressed on the
    // OUTERMOST scope runs before the focused child's key handler (events-and-overlays), so
    // this sees Ctrl+O first, and every key it returns Ignore for keeps travelling to
    // TextEdit - which is why nothing below mentions Ctrl+A/C/V: an editor chord that is not in
    // this table reaches the caret untouched. No imperative focus() anywhere, which is the other
    // half of the same rule (a bridge that steals focus to route a key loses the caret). ONE
    // exception, and this sentence is the reason S10b had to edit it: Ctrl+Z and Ctrl+Y ARE named
    // below - not as commands, but as a quarantine that arms only after the first document
    // switch. See undo_quarantined() in src/main.rs for why, and for what it costs.
    //
    // THE DIFF SHAPE, on purpose: the children below are NOT re-indented, so the body reads
    // as if it were still one level. Slint does not care and a 90-line re-indent would bury
    // the four lines that matter in a wall of whitespace. Delete this note the first time
    // anything reformats this file.
    keys := FocusScope {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        forward-focus: editor;

        capture-key-pressed(event) => {
            // Shift first: Ctrl+Shift+R is a different act from a hypothetical Ctrl+R, and a
            // shift-letter arrives as the UPPER-case glyph, hence to_lowercase everywhere.
            // S7: ESCAPE, and the parity question is answered by a WARNING, not by silence.
            // menu.rs has NO Escape row in its legend because Escape is not a command there -
            // and titlebar.rs:244-246 goes further: the first bridge deliberately leaves the
            // key to the editor (main.rs:1499 binds it to editor::EscapeSelection, clearing a
            // selection) and never dismisses its popup with it. This bridge takes the key ONLY
            // while the popup is open, so an editor Escape is untouched - but that IS a
            // behavioural divergence from the model, made visible here rather than smoothed
            // over, and it is why the chord table in main.rs stays at fourteen rows: a
            // dismissal is not a command and does not belong in a legend of commands.
            if (event.text == Key.Escape && chrome.menu-open) {
                chrome.escape-asked();
                return EventResult.accept;
            }
            // S10b: THE UNDO QUARANTINE, and it is a state rule, not a chord.
            // 1.17 cannot clear a TextEdit's undo stack (verified in S10), and the stack
            // survives a document switch because the widget is never destroyed - the
            // conditional-recreation answer needs a focus path 1.17 does not have (the finding is
            // written out in src/main.rs). So from the first switch onward Ctrl+Z holds the
            // PREVIOUS document's bytes, and replaying them writes them into the NEW one under a
            // legal new epoch: the engine's own guard cannot see it, and the hazard is unbounded
            // in time. Swallowing the two replay keys is the only mitigation that ships today,
            // and it is gated on generation > 0 so that before any switch the stack is honest and
            // the keys reach the editor untouched through the reject path below. THE COST, for
            // the commit message: after the first document switch, undo and redo are DEAD for the
            // session - a quiet loss of the editor's most-used keys, taken because the alternative
            // is corrupting a file the user never typed into. The un-kill is upstream: clear-undo
            // on TextEdit, or a way to focus a conditionally created editor so the recreation can
            // ship. This branch is the seam they replace. SHIFT IS DELIBERATELY ALLOWED: the
            // usual redo chord is Ctrl+Shift+Z, so a rule that excluded shift would have left the
            // same stale bytes reachable through the key that redoes - which is how this branch
            // was first written, and corrected before it shipped.
            if (root.doc-generation > 0
                    && event.modifiers.control
                    && !event.modifiers.alt
                    && (event.text.to_lowercase() == "z"
                        || event.text.to_lowercase() == "y")) {
                root.undo-swallowed();
                return EventResult.accept;
            }
            if (event.modifiers.control && event.modifiers.shift
                    && event.text.to_lowercase() == "r") {
                root.clear-recents-asked();
                return EventResult.accept;
            }
            if (event.modifiers.control && !event.modifiers.alt && !event.modifiers.shift) {
                if (event.text.to_lowercase() == "o") {
                    root.open-asked();
                    return EventResult.accept;
                }
                if (event.text.to_lowercase() == "s") {
                    root.save-as-asked();
                    return EventResult.accept;
                }
                // menu.rs binds Ctrl+T to ToggleAutosave, NOT to a new note; see the popup
                // header in chrome.slint for why new-note is parked rather than invented.
                if (event.text.to_lowercase() == "t") {
                    root.autosave-asked();
                    return EventResult.accept;
                }
            }
            // Alt+1..9 = recent 1..9, Alt+0 = recent 10 - the ten-rows-in-one-hand convention,
            // and the same open-at-index(int) the recents rows call.
            if (event.modifiers.alt && !event.modifiers.control && !event.modifiers.shift) {
                if (event.text == "1") { root.open-at-index(0); return EventResult.accept; }
                if (event.text == "2") { root.open-at-index(1); return EventResult.accept; }
                if (event.text == "3") { root.open-at-index(2); return EventResult.accept; }
                if (event.text == "4") { root.open-at-index(3); return EventResult.accept; }
                if (event.text == "5") { root.open-at-index(4); return EventResult.accept; }
                if (event.text == "6") { root.open-at-index(5); return EventResult.accept; }
                if (event.text == "7") { root.open-at-index(6); return EventResult.accept; }
                if (event.text == "8") { root.open-at-index(7); return EventResult.accept; }
                if (event.text == "9") { root.open-at-index(8); return EventResult.accept; }
                if (event.text == "0") { root.open-at-index(9); return EventResult.accept; }
            }
            // THE NEGATIVE CLAIM, in one line: everything else - every editor chord, every
            // typed character, every unbound key - goes back to the focused child untouched.
            return EventResult.reject;
        }

    // --- what the port last said, and the editor (S4 wires its text) ---
    status-line := Text {
        x: 8px;
        y: chrome.height + 2px;
        text: root.status;
        color: Theme.text-secondary;
        font-size: 11px;
    }

    // One row per entry, `for` over the array the port sent.
    for name[index] in root.recents: Rectangle {
        x: 0px;
        y: status-line.y + 18px + index * root.row-h;
        width: parent.width;
        height: root.row-h;
        Text {
            x: 6px;
            vertical-alignment: center;
            text: name;
            color: Theme.text-row;
            font-size: 11px;
        }
        TouchArea {
            clicked => {
                root.open-at-index(index);
            }
        }
    }

    editor := TextEdit {
        x: 0px;
        y: status-line.y + 18px + root.stack-h;
        width: parent.width;
        height: parent.height - status-line.y - 18px - root.stack-h;
        font-size: 14px;
        // S10, PARITY: no wrapping. Not a style choice - the whole project never wrapped
        // (editor.rs:883 puts word wrap out of scope) and the first bridge never had it, so
        // the toolkit's prettier default is a behavioural difference between two bridges that
        // are supposed to be the same app. Long lines scroll; they do not fold.
        wrap: TextWrap.no-wrap;
        // Two-way binding: `set_buffer` repaints the widget, typing refills the
        // property, and the pump reads only the property.
        text <=> root.buffer;
        // S10: the dirty witness, event-driven. Every keystroke arrives here, so the pump no
        // longer has to read and compare the whole buffer 125 times a second to learn that
        // something changed. See text_pump for how the flag replaced the comparison, and for
        // what the comparison is still doing here.
        edited => {
            root.text-edited();
        }
    }
    // S7, THE BACKDROP: the click-away the first bridge got from the kit's window-level
    // on_mouse_down_out and that a TouchArea cannot express from inside a component. It covers
    // the WHOLE window, it exists only while the popup is open (visible AND enabled both follow
    // chrome.menu-open, so a closed menu cannot swallow a click - the editor keeps every pixel
    // the instant the popup is gone), and it is declared between the editor and the bar, which
    // is the only position in the sibling order where it is above the text and below the popup.
    // It forwards the click; it does not close anything. Chrome owns that.
    backdrop := TouchArea {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        visible: chrome.menu-open;
        enabled: chrome.menu-open;
        clicked => {
            chrome.backdrop-asked();
        }
    }

    // --- THE TITLE STRIP: S2's Chrome, mounted, not re-implemented ---
    // Chrome owns the look, the drag and the caption. It is handed facts and returns
    // asks; everything it shows arrives from an Event.
    chrome := Chrome {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 28px;
        // S7: the two numbers Chrome cannot see for itself. Geometry RESTORE is bridge work
        // and geometry STORAGE is core work (AGENTS.md); a popup's clamp is neither - it is
        // Chrome's own layout - so the host states its size instead of the bar reaching out.
        toggle-asks: root.toggle-asks;
        close-asks: root.close-asks;
        host-width: root.width;
        host-height: root.height;
        // S8, and this line is worth more than the property it replaces: I declared a property
        // for exactly this, and slint refused it with a WARNING - Window already owns
        // 'maximized' (builtins.slint:1524, in-out, and setting it maximizes the window). So
        // the bar's state input is ONE BINDING to the window's own bit: no pump field, no poll
        // feeding a mirror, no second copy of a fact the window can change behind our back
        // (taskbar, Win+Up, a drag to the screen edge) - which is the bug class this spike keeps
        // finding. Declaring my own was worse than redundant: the shadow takes the generated
        // setter with it, so ui.set_maximized() would have written my copy and stopped
        // maximizing anything at all.
        title: root.title-words;
        pinned: root.pinned;
        dirty: root.dirty;
        save-failed: root.save-failed;
        autosave: root.autosave;
        // C1: Chrome carries a pin STATE, never a window level - nothing in this file
        // names always-on-top or a level, and notes-platform stays the one
        // WS_EX_TOPMOST writer. The bool Chrome hands back is the WIDGET'S GUESS at
        // what the user wants; it is dropped here, and the ask goes through the one
        // existing path in Rust, which decides from the port's last confirmed bit.
        toggled-pin(asked) => {
            root.taps += 1;
            root.asked-guess = asked;
            root.toggled-pin();
        }
        // S4b: the title band's double-click. Chrome emits the ASK and owns no geometry
        // (set_maximized is a window call, so it lives in Rust); this forwards it to the
        // existing toggle-max() callback, which main.rs already binds to the SAME
        // toggle_max() the synthetic driver calls - one implementation, two triggers.
        toggle-max-requested => {
            root.toggle-max();
        }
        drag-delta(dx, dy) => {
            root.drag-delta(dx, dy);
        }
        drag-ended => {
            root.drag-ended();
        }
        open-asked => {
            root.open-asked();
        }
        save-as-asked => {
            root.save-as-asked();
        }
        autosave-asked => {
            root.autosave-asked();
        }
        clear-recents-asked => {
            root.clear-recents-asked();
        }
        quit-asked => {
            root.quit-asked();
        }
        toggle-menu-asked => {
            root.toggle-menu-asked();
        }
        backdrop-asked => {
            root.backdrop-asked();
        }
        escape-asked => {
            root.escape-asked();
        }
        minimize-requested => {
            root.minimize-requested();
        }
    }

    } // keys := FocusScope - closes the S6 chord wrap (see its comment above)
}
