// S3 UI payload for the slint bridge: a title strip that can ask to be pinned,
// a status line the pump writes, and a deliberately dumb editor (the text<->Flush
// loop is S4). The four slint-1.17 findings from the out-of-tree spike are encoded
// here, each where it bites:
//  1. widgets are NOT builtins - TextEdit has to come from the style library.
//  2. Rectangle.color is deprecated; `background` is the current name.
//  3. a handler may not assign an `in` property ("Assignment on a input property"),
//     so anything the UI writes locally is declared `in-out`.
//  4. `export { X }` takes no trailing semicolon (the semicolon is a hard error).

import { TextEdit } from "std-widgets.slint";

export component Spike inherits Window {
    title: "notes-slint spike (pin + pump)";
    no-frame: false;

    // C1, and this line is the whole point: Slint's OWN always-on-top property is
    // never mentioned here and stays at its default. notes-platform, through the
    // port, is the single WS_EX_TOPMOST writer - so `pinned` below is a RENDER of
    // what the port reported, not a wish.
    in property <bool> pinned: false;
    in property <string> status: "starting";

    // The only thing the strip may decide by itself. `in-out`, per finding 3.
    in-out property <int> taps: 0;

    // THE BUFFER, and the whole reason `in-out` is not a workaround: the port's text
    // lands here on a load, and every keystroke lands here too, so Rust reads one
    // property instead of reaching into a widget (architecture 5.5 - the bridge owns
    // the editor, api never sees a keystroke).
    in-out property <string> buffer;
    callback toggled-pin();

    // --- title strip: the pin ask ---
    bar := Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 28px;
        background: pinned ? #445566 : #2b2b2b;

        pin-toggle := TouchArea {
            clicked => {
                root.taps += 1;
                // No local flip of `pinned`: the click asks, the port answers.
                root.toggled-pin();
            }
        }

        Text {
            x: 8px;
            vertical-alignment: center;
            text: pinned ? "PINNED - port-confirmed" : "unpinned";
            color: #eeeeee;
            font-size: 12px;
        }

        Text {
            x: parent.width - 70px;
            vertical-alignment: center;
            text: taps > 0 ? "tapped" : "";
            color: #999999;
            font-size: 11px;
        }
    }

    // --- what the port last said, and the editor (S4 wires its text) ---
    status-line := Text {
        x: 8px;
        y: bar.height + 2px;
        text: root.status;
        color: #bbbbbb;
        font-size: 11px;
    }

    editor := TextEdit {
        x: 0px;
        y: status-line.y + 18px;
        width: parent.width;
        height: parent.height - status-line.y - 18px;
        font-size: 14px;
        // Two-way binding: `set_buffer` repaints the widget, typing refills the
        // property, and the pump reads only the property.
        text <=> root.buffer;
    }
}
