// S2 BAR GEOMETRY for the slint bridge: the FIRST bridge's title bar, ported as markup.
//
// The model is crates/bridge-gpui/src/titlebar.rs - the only shipped implementation of
// ADR-0003's band, and the one where these decisions were already argued out: the 60px slot
// at either end of the centre (:57 + the slot() helper at :296), what the centre may say
// (:124), the rows the popup may offer - the model's five and why two plausible ones are
// absent from it (:183) - plus a sixth that the model has no cell for, because the model never
// owed Slint anything and the licence does: About, the section 2(a) door, spelled out in the
// ABOUTSLINT block below.
// and the dot's three states with their precedence (:67-104). This file re-states their
// SHAPE in slint. It does not re-decide them, and every place the shape could not cross the
// bridge is said out loud below instead of being smoothed over.
//
// NOT PORTED, and why:
//   * The RIGHT region and the drag. There the kit's own TitleBar draws the Windows caption
//     buttons and owns the drag (titlebar.rs:5-9). Here no-frame is on and the caption area
//     is not ours, so the right slot keeps its PURPOSE - the centring argument needs both
//     ends to be the same fixed width - without duplicating a caption.
//   * Click-away - PORTED AT S7, AND IT COSTS A MOUNTING RULE. A slint TouchArea has no
//     "outside" event, so the full-window catcher is installed by whoever mounts Chrome,
//     exactly as the note above said it would have to be: main.slint declares a backdrop
//     between the editor and this bar, because that is the only sibling position where it is
//     above the text and below the popup. It forwards a click to backdrop-asked() and closes
//     nothing itself. Escape is now wired HERE, and that is a deliberate divergence from the
//     model, which leaves the key to the editor (titlebar.rs:244-246, main.rs:1499): this
//     bridge takes Escape only while the popup is open, so an editor Escape is untouched.
//   * The popup as "last child of the window's root element" (titlebar.rs:236-240). A
//     component cannot choose its own sibling order, so painting above the editor is decided
//     wherever Chrome is mounted. The frame is OPAQUE for that reason: a translucent menu
//     laid over text is unreadable, and z-order is not something this file can guarantee.
//   * One geometry divergence: the first bridge's band is the kit's 34px
//     (TITLE_BAR_HEIGHT); this bar is the 28px this bridge already ships (Theme.bar-height,
//     harvested from ui/main.slint). That height is the kit's argument, not ADR-0003's.
//
// Nothing is mounted from here and no Rust is owed by this file: every value the bar cannot
// decide itself arrives as an 'in' property (the port's answers - pinned, dirty,
// save-failed, autosave, title) and every click leaves as a callback that only ASKS. That is
// the spike's rule, not a style: the UI never flips 'pinned' locally, because notes-platform
// through the port is the single WS_EX_TOPMOST writer.

import { Theme } from "theme.slint";

// ABOUTSLINT: the licence's live obligation, not a courtesy. The Slint royalty-free licence
// (LicenseRef-Slint-Royalty-free-2.0.md, §2) is granted "provided that You do EITHER of the
// following", and of its two doors only one is open to this project: (b) is a badge on a download
// page, and there is no download page - so (a) is the obligation: "Display the AboutSlint widget in
// an About screen or dialog accessible from the top level menu". That is precisely the row and the
// panel below. The widget itself is std: it is exported by EVERY style's std-widgets.slint
// (i-slint-compiler-1.17.1/widgets/fluent/std-widgets.slint:6 re-exports ../common/about-slint.slint)
// and SLINT_STYLE is unset here, so the fluent default is what compiles - and the import door is
// the one this file's sibling already uses for TextEdit: "std-widgets.slint".
// Its own Platform.open-url MAY silently no-op under winit, which is why the panel is a box with
// the widget INSIDE it rather than a link: §2(a) asks for the ATTRIBUTION, and the text is the
// compliance; a clickable logo would be a nice extra nobody should rely on.
// PLACEMENT is not the implementer's call, so it is recorded exactly as it was given:
// placement chosen 2026-09-14: About lives in the hamburger menu, which is also the license clause door.
//
// THE DOOR, and this one line is the whole of the earlier failure. The element EXISTS (its
// source is i-slint-compiler-1.17.1/widgets/common/about-slint.slint) and every style's
// std-widgets.slint RE-EXPORTS it, but a name in the style library is reachable ONLY through
// that re-export - which is exactly how ui/main.slint:11 gets its TextEdit. Without this import
// the compiler says "Unknown element 'AboutSlint'", ui_gen.rs then exports no Spike, and every
// Rust user of the generated module dies with E0432 - which is what a broken markup tree looks
// like from the inside, and why the error you see is never the error you have.
import { AboutSlint } from "std-widgets.slint";

/// The dot's three states as a value, not as a color, so the precedence is one readable
/// expression and only one line owns hex digits - the same separation Dot / dot_state() /
/// Dot::color() keep in the model (titlebar.rs:67-104).
enum DotState {
    clean,
    dirty,
    failed,
}

/// THE BAR: left slot (hamburger + pin), centred dot and title, matching empty right slot.
export component Chrome inherits Rectangle {
    // 100%, not parent.width: a component's ROOT element has no 'parent' id - slint
    // refuses it (measured). The percentage reaches the same number and keeps Chrome
    // mountable at any width, which is what a bar is for.
    width: 100%;
    height: Theme.bar-height;

    // ---- what the port reported -------------------------------------------------
    in property <string> title: "Untitled";
    in property <bool> pinned: false;
    in property <bool> dirty: false;
    in property <bool> save-failed: false;
    /// The wire's own word ('autosave'): a row that always said "Auto-save" would render a
    /// toggle whose position is invisible (titlebar.rs:188-206).
    in property <bool> autosave: false;

    // ---- what the popup EXPLAINS, as opposed to what it acts on -----------------------------
    // Two sticky strings, written by Rust and computed by nothing here. They are sticky because the
    // status line cannot hold them: `set_status` has one writer, so the sentence explaining a
    // refused write is erased by the next event, and docs/features.md §4.4 asks for the reason in
    // the MENU - a surface a person opens after the fact, when they are wondering whether their
    // notes are safe. `file-words` is core's FileMeta verdict on the document that is open, in the
    // same sentence bridge-gpui prints.
    in property <string> why-not-saved: "";
    in property <string> file-words: "";

    /// THE RECENTS, moved home. The README has described this surface as the menu holding
    /// "recent files (up to 10) with Clear" from the first draft, and for five slices the rows
    /// lived OUTSIDE it - a stack under the status line, computed by main.slint, which pushed the
    /// editor down and dismissed nothing. Here they are rows of the popup: they hang under the six
    /// command rows and above the footer (ACTS OVER PROSE - see footer-y below), and a pick closes
    /// the menu the way every other act does. The labels are core's words verbatim, built by
    /// recents_rows in surface.rs, and no path crosses into markup: an index is what maps back to
    /// a file, which is the same rule the stack followed.
    in property <[string]> recents;

    /// A recent row was clicked. Chrome fires the index and asks nothing else - main.slint
    /// forwards this to its OWN open-at-index(int), the very callback Alt+1..0 reach, so a pointer
    /// and a chord cannot grow two answers to "open number three".
    callback open-at-index(int);

    // ---- what the bar may decide by itself --------------------------------------
    // 'in-out', not 'in': a handler may not assign an 'in' property (this bridge's own
    // finding 3), and the menu is local state - it opens a list of things the app already
    // knows how to do, so unlike the pin it asks the port nothing and expects no answer.
    in-out property <bool> menu-open: false;

    /// The About screen's own bit, and it is deliberately SEPARATE from menu-open: the licence
    /// asks for a screen reachable from the top level menu, and a widget that only exists while a
    /// popup is open is not a screen. Chrome owns both bits, and both are written in this file.
    in-out property <bool> about-open: false;
    /// Forwarded by the mount so a synthetic act and a real row click go through ONE door (the same
    /// counter pattern as toggle-asks above, which cost a build to learn - a component callback
    /// cannot be invoked from Rust through the parent).
    in property <int> about-asks: 0;

    // ---- the host's size, told to the bar because a bar cannot see its own window ------
    // S7: the popup's clamp is a question about the WINDOW, and a component may not reach out
    // to ask it (the same reason this file never reads a window level). So the mounter states
    // both numbers. 0px means "not told yet", and the clamp reads that as "no information,
    // keep the inset" rather than clamping against a zero-width host.
    // S7, LEARNED THE HARD WAY: a component callback CANNOT be invoked from Rust through
    // the parent forward. ui.invoke_toggle_menu_asked() reached Spike own callback - whose
    // only handler is whatever Rust attaches - and Chrome handler never ran, so the popup sat
    // closed and the needle printed menu-shown=false while every line of the wiring was
    // correct. The fix is the pattern this bar already uses to close a window: the ask
    // travels as a NUMBER (main close-arm), and Chrome reacts to the change. menu-open still
    // has exactly one writer, and a probe can drive it without hands.
    in property <int> toggle-asks: 0;
    in property <int> close-asks: 0;

    // S8: the caption button's ONE state input, and it is an answer, not a wish. The bar
    // cannot ask the window whether it is maximised - a component may not reach its window,
    // the same rule that keeps 'pinned' an in-property - so the mounter tells it. One-way by
    // construction ('in', never 'in-out'): a bar that could flip the bit would be a second
    // writer of a state the window owns. Until main.slint feeds it, this reads false and the
    // button shows the maximize glyph; caption_glyph() in src/main.rs is what pins the two
    // filenames to each other so the swap cannot drift from the condition.
    in property <bool> maximized: false;

    // The caption slot's measure: three cells of Theme.icon-size, i.e. one and a half of the
    // left slot. Deliberately NOT equal to the left slot, and that asymmetry has a cost - see
    // the CENTRE note, where it is paid out loud instead of being smoothed over.
    property <length> caption-width: Theme.slot-width * 1.5;

    in property <length> host-width: 0px;
    in property <length> host-height: 0px;

    /// THE CLAMPED POSITION: floor on the left, ceiling on the right, 8px each side, and
    /// width-aware - the ceiling only exists because the host has a width at all. The FLOOR
    /// binds first on any window that can hold the popup, because the raw inset is 4px, so
    /// the interesting case is a narrow host where the ceiling takes over. `popup-overflow`
    /// says the remainder out loud instead of letting the menu hang off an edge in silence:
    /// no pair of 8px margins fits a 190px menu into a 198px window, and a flag that admits
    /// that beats a screenshot that hides it.
    in property <length> popup-x: root.host-width <= 0px
        ? Theme.menu-inset
        : Math.max(8px, Math.min(Theme.menu-inset, root.host-width - Theme.menu-width - 8px));
    in property <bool> popup-floored: root.host-width > 0px && root.popup-x > Theme.menu-inset;
    in property <bool> popup-overflow: root.host-width > 0px
        && root.popup-x + Theme.menu-width > root.host-width - 4px;

    /// THE SAME ARGUMENT, TURNED DOWN THE PAGE. Nothing in this app enforces a minimum window
    /// height - not the Window, not the bridge, not `platform` - and Slint clips a child at the
    /// client edge with no scroll and no warning, so a menu that hangs below a 28px band in a short
    /// window loses whatever is at the bottom: the About row, and then the two lines that explain
    /// why a file is not being saved. Clipping is the one outcome a popup must never reach.
    ///
    /// So the popup keeps its own bottom edge INSIDE the host by moving its top edge up, the way a
    /// platform menu does when there is no room under the bar: what the shortfall costs is the
    /// overlap of the bar's lower pixels, not the loss of a row. `parent.height` (the resting y of
    /// both blocks) is the bar's own height, which is `Theme.bar-height`, which main.slint's
    /// `height: 28px` and theme.slint agree on - stated as the token here because a function cannot
    /// be asked what somebody else's parent is.
    ///
    /// NOT APPLIED TO THE X RULE. `popup-x` is printed as evidence by the frozen instrument
    /// (probe.rs:1837, `popup-x=... floored=... overflow=...`), and an instrument that acquires new
    /// assertions after its verdict is a wish, not evidence (ADR-0006 §4) - so the width rule stays
    /// where its verdict left it, and the known gap that About is 340px wide while `popup-x` is
    /// computed for a 190px menu is recorded instead of quietly fixed. Height is not under that
    /// freeze: nothing has ever printed a y position, so this adds a rule and not a re-writing.
    function popup-top(needed: length) -> length {
        root.host-height <= 0px
            ? Theme.bar-height
            : Math.max(0px, Math.min(Theme.bar-height, root.host-height - needed - Theme.menu-gap))
    }
    in property <bool> menu-raised: root.host-height > 0px
        && root.popup-top(menu.height) < Theme.bar-height;
    in property <bool> about-raised: root.host-height > 0px
        && root.popup-top(about.height) < Theme.bar-height;

    /// THE SAME RULE ON THE AXIS `popup-x` IS NOT ALLOWED TO LEAVE - and here, a working one.
    ///
    /// `popup-x` reads `Math.max(8px, Math.min(Theme.menu-inset, host-width - menu-width - 8px))`, and
    /// because its FLOOR (8px) sits ABOVE the inset its ceiling is capped against (4px), the min-term
    /// can never survive the max: the expression returns **8px on every host**, from 1200 down to 190,
    /// arithmetically - and `popup-floored` is therefore true everywhere, which is accurate but says
    /// nothing, while the comment's "the interesting case is a narrow host where the ceiling takes
    /// over" describes a branch that cannot execute. The flag that does carry information is
    /// `popup-overflow`, and it only lights below a ~202px host, because a 190px menu at x=8 overflows
    /// at 198. None of that is fixable here: the instrument prints popup-x as recorded evidence
    /// (probe.rs:1837) and plumbing.rs counts the expression so a change must be meant. It is recorded
    /// in this file's note, and the fix is the same re-earning keyboard traversal needs.
    ///
    /// About is not under that verdict, and About is the block the inertness actually damages: 340px
    /// where the rule was computed for 190px. So this is the rule the other one intended - rest at the
    /// same 8px the menu sits at, because the two blocks must line up, ceiling at host - width - 8, and
    /// a FLOOR OF ZERO because a cut licence is worse than no left margin. It buys real ground: on a
    /// 348px host the panel moves to x=0 and the whole 340px of it is on screen, where the inert rule
    /// left it hanging 8px off the edge.
    ///
    /// Its own width is read, not copied: probe.rs:2105 pins the literal `width: 340px;`, so a token
    /// would put the number in two places and one of them is frozen.
    function popup-left(needed: length) -> length {
        root.host-width <= 0px
            ? Theme.menu-inset
            : Math.max(0px, Math.min(8px, root.host-width - needed - 8px))
    }
    in property <bool> about-floored: root.host-width > 0px
        && root.popup-left(about.width) < 8px;
    /// Below this there is no placement at all: with the margin spent, a 340px panel needs 340px of
    /// host, and the licence is cut whatever x says. Said as a flag for the reason `popup-overflow`
    /// gives - a flag that admits beats a screenshot that hides.
    in property <bool> about-overflow: root.host-width > 0px
        && root.host-width < about.width;

    /// B-S5: DOES THIS HOST HOLD THE LICENCE AT ALL - the gate on the ACT, not on the layout.
    ///
    /// The panel is a fixed box (see its own block below), Chrome can move it inside the host it is
    /// given but cannot make the host bigger, and Slint clips a child at the client edge with no
    /// scroll and no warning - so on a short or narrow window the act currently offered in row 5
    /// produces a CUT licence and no sentence saying so. about-overflow already admits the width
    /// case; this is the decision the admission was waiting for: do not open what cannot be shown.
    ///
    /// Both terms are the panel's OWN numbers, never a copy of them: the width demand is
    /// about.width with no padding (popup-left's floor is zero, so the 8px margins are policy while
    /// the width is obligation), and the height demand is about.height plus the ONE menu-gap that
    /// popup-top keeps below it. The border is not a term - a Slint Rectangle draws it centered on
    /// the geometry edge, so the box's own height already includes it.
    ///
    /// An unknown host (host-width 0, the frames before the first layout) FITS: the same
    /// "when in doubt, show the licence" direction popup-left takes on that input. A gate that
    /// refuses on its own missing measurement would be worse than no gate.
    ///
    /// Internal on purpose - no visibility, so no generated setter for anyone and no new mirror to
    /// read: the mount already exports the three flags this is built from.
    property <bool> about-fits: root.host-width <= 0px
        || (root.host-width >= about.width
            && root.host-height >= about.height + Theme.menu-gap);

    // ---- the asks ---------------------------------------------------------------
    // toggled-pin carries the state to ASK for, because this closure cannot see the wire and
    // the bridge must not keep a second copy of the bit (titlebar.rs:310-311).
    callback toggled-pin(bool);
    callback open-asked();
    callback save-as-asked();
    callback autosave-asked();

    /// S6: Clear recents. Its own ask because its own command - `Command::ClearRecents`
    /// exists in the port and nothing else in this bar sends it. It is also the only row
    /// whose chord (Ctrl+Shift+R) takes two modifiers, which is why the chord table in
    /// main.rs routes by name instead of by a hand-copied string.
    callback clear-recents-asked();

    // ---- S7: the three ways a popup closes, and all three are ASKS ----------------------
    // Every one lands on a handler inside THIS component, because menu-open has exactly one
    // writing component. A backdrop cannot see the popup and the keyboard cannot see the bar,
    // so both ask. The S7 proof is two greps: every 'menu-open =' in this file is Chrome's,
    // and main.slint contains none at all.

    /// Click-away - the route the first bridge got free from the kit's window-level
    /// on_mouse_down_out (titlebar.rs:244-246), which a TouchArea has no equivalent of. The
    /// mounter lays a full-window catcher UNDER this bar and forwards its click here.
    callback backdrop-asked();

    /// Escape, same shape: captured at the window's outer focus scope, routed here only when
    /// the popup is actually open. See main.slint for the parity warning - the first bridge
    /// deliberately leaves Escape to the editor.
    callback escape-asked();

    /// A5: the plain Save, the same one-callback shape as save-as-asked - the key matcher in
    /// main.slint and the row in this file both end at THIS callback, so a write to the current path
    /// has one route out of the markup. It is not a dialog: Save As keeps that to itself.
    callback save-asked();

    /// The hamburger's ask, as a callback, so the click handler on menu-touch and the synthetic act
    /// share ONE body - but only FROM THE CALLBACK INWARD, and that limit is the honest wording.
    /// Both routes arrive here (the press at menu-touch's clicked arm, the counter the `changed` arm
    /// below reads), and from this line on there is exactly one implementation. What is NOT shared,
    /// and has never been tested, is the road from a pixel to this callback: every instrument that
    /// opens the popup raises the counter, which bypasses hit-testing entirely, and the only legs in
    /// the repo that press real pixels are smoke modes 4-7 - which carry no recorded green run
    /// anywhere. So do not read this comment as "the pointer path works": it says one body from the
    /// callback in, and nothing further.
    callback toggle-menu-asked();

    /// S8: minimize - the only one of the three caption buttons with no door to reuse.
    /// Maximize takes the double-click's 'toggle-max-requested' and close takes the Quit
    /// row's 'quit-asked', both already single doors; this has to be new. Which means it also
    /// needs one forward line in main.slint, outside this slice's fence: until that lands the
    /// glyph is an honest placeholder that does nothing, and the report says so rather than
    /// the code being the only place that knows.
    callback minimize-requested();
    /// Quit is not a command: it closes this window, which is the one shutdown route that
    /// flushes and joins the engine (titlebar.rs:226-232). Its own callback so the bridge
    /// cannot mistake it for a fifth command.
    callback quit-asked();

    /// THE DOUBLE-CLICK ASK. Chrome EMITS this and decides nothing about geometry:
    /// whether a maximised window comes back maximised, which rect gets stored, and the
    /// GeometryChanged the port then writes are Rust's and the port's business (AGENTS.md:
    /// geometry RESTORE is bridge work, geometry STORAGE is core work). main.rs binds this
    /// to the same toggle_max() the synthetic timer drives, so one implementation has two
    /// triggers - which is exactly why it is a callback and not a window call in here.
    callback toggle-max-requested();

    /// THE DRAG ASK. Chrome reports the pointer's movement between frames and NOTHING
    /// else: no position, no window call, no opinion about what frame-inclusive means.
    /// The bug class this keeps out is the double-count - a title band that moves the
    /// window by itself reads a CLIENT rect and writes a FRAME position, so every drag
    /// walks the window a chrome-height further than the pointer went, and the next
    /// restore does it again (smoke.rs carries the history: "the relaunch rect walked by
    /// its own chrome"). A delta is origin-independent, which is why the markup may carry
    /// exactly this and nothing else.
    callback drag-delta(length, length);

    /// The release. One GeometryChanged per DRAG, not one per frame: the port is asked to
    /// store a rect when the user stops moving the window.
    callback drag-ended();

    // ---- the dot ----------------------------------------------------------------
    // failed outranks dirty: dirty already says "you have unsaved text" and the amber exists
    // to add "and the app could not write it". A failed save over a clean buffer is the
    // impossible-but-cheap case; the failure is still the more urgent word, so it wins. That
    // is the whole of dot_state(), and it is the only precedence rule in this file.
    // 'dot-state', not 'dot': the element below is 'dot-cell := Rectangle', and this
    // bridge has already been bitten once by a short name that another scope owns
    // (ui/main.slint finding 5: plain 'row' is refused). Renaming was DUE DILIGENCE, NOT
    // THE FIX - measured: with the old names and the stray 'animate background' deleted,
    // the red dot painted anyway. The bug was the animate, and the comment at the bar paint
    // says so. Kept the rename because a property and an id that differ by a suffix in
    // different scopes is still a trap the next reader should not have to step around.
    property <DotState> dot-state: root.save-failed ? DotState.failed
        : root.dirty ? DotState.dirty : DotState.clean;
    property <brush> dot-paint:
        root.dot-state == DotState.failed ? Theme.amber
        : root.dot-state == DotState.dirty ? Theme.red
        // Clean paints NOTHING: a dot that is always on screen cannot carry a state.
        : transparent;

    // THE BAR PAINT, on a filling child, as a PLAIN binding - no 'animate' beside it.
    //
    // What was measured here (slint-viewer 1.17.1, --check clean, three renders):
    //   background ternary + 'animate background' on the same element  -> the lit color
    //     NEVER appeared in the render (histogram had no #445566 at all);
    //   the same binding with the animate deleted                      -> #445566 painted
    //     5237 px, and the dirty dot's red with it (32 px of a 7px circle);
    //   a cross-fading overlay driven by 'opacity: pinned ? 1 : 0' plus 'animate opacity'
    //     -> lit color absent again.
    // So an animate sitting on the very property that carries a STATE is not safe to ship
    // on the two signals this app cannot afford to lose (pinned, dirty). Mechanism not
    // settled - a screenshot is one frame, and the dot's 'animate width' survived the same
    // test - which is exactly why it is stated instead of explained. REOPEN: watch a live
    // window change state, and if the ease is the thing breaking the paint, file it
    // against slint; polish.md's 150-200ms is still honored where nothing observable is
    // asked to animate (the hover tints below, which a screenshot cannot show either way).
    bar-bg := Rectangle {
        width: 100%;
        height: 100%;
        background: root.pinned ? Theme.bar-bg-pinned : Theme.bar-bg;
    }

    // ---- LEFT: one 60px slot, two buttons ---------------------------------------
    // 60px because that is what the model measures for the same shape (titlebar.rs:50-57):
    // two buttons' widths, and the empty right slot has to match it or the centring below
    // reads as a left shift.
    HorizontalLayout {
        x: 0px;
        y: 0px;
        width: Theme.slot-width;
        height: parent.height;
        alignment: center;

        // The hamburger: three strokes computed from the theme, not an asset file. That is
        // the right call for the same reason the pin is the WRONG one - icons-and-theming.md
        // reserves Path and hand-drawn shapes for geometry you compute or animate, and gives
        // icon SETS to Image + svg; this is three rectangles, and the pin is a glyph.
        menu-btn := Rectangle {
            width: Theme.icon-size;
            height: parent.height;
            hover-menu := Rectangle {
                width: parent.width;
                height: parent.height;
                background: Theme.hover-bg;
                opacity: menu-touch.has-hover ? 1 : 0;
                animate opacity { duration: 180ms; }
            }
            for line[index] in [0, 1, 2]: Rectangle {
                x: 5px;
                y: parent.height / 2 - 5px + index * 4px;
                width: parent.width - 10px;
                height: 2px;
                border-radius: 1px;
                background: root.menu-open ? Theme.amber : Theme.icon-muted;
            }
            menu-touch := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => {
                    root.toggle-menu-asked();
                }
            }
        }

        // THE PIN: the glyph changes as well as the color, because colour alone is the one
        // signal this app cannot own - a grey-on-dark bar is exactly where a tint difference
        // is the first thing a user loses (titlebar.rs:106-116).
        pin-btn := Rectangle {
            width: Theme.icon-size;
            height: parent.height;
            hover-pin := Rectangle {
                width: parent.width;
                height: parent.height;
                background: Theme.hover-bg;
                opacity: pin-touch.has-hover ? 1 : 0;
                animate opacity { duration: 180ms; }
            }
            Image {
                x: (parent.width - Theme.icon-size) / 2;
                y: (parent.height - Theme.icon-size) / 2;
                width: Theme.icon-size;
                height: Theme.icon-size;
                source: root.pinned ? @image-url("icons/pin.svg") : @image-url("icons/unpin.svg");
                colorize: root.pinned ? Theme.amber : Theme.icon-muted;
            }
            pin-touch := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => {
                    // Ask, never flip: 'pinned' above is the port's answer, not a wish.
                    root.toggled-pin(!root.pinned);
                }
            }
        }
    }

    // ---- RIGHT: the caption slot - minimize, maximize/restore, close ----------------
    // THE FRAMELESS HOLE this fills: no-frame is on, so the OS draws no buttons at all and
    // minimize/maximize were reachable only by a keyboard chord nobody can see. And there is
    // NOTHING to port: titlebar.rs:5 and :293-294 say the first bridge's caption buttons are
    // painted by the KIT, outside its children row, and that its own right slot is empty ON
    // PURPOSE. So this region is authored, under the two rules the left slot already follows:
    // hover is an opacity fade on a derived tint, and a glyph is an Image asset the theme
    // colorizes rather than a shape drawn here (icons-and-theming.md: geometry you compute or
    // animate is a Path, an icon SET is an svg).
    // Three cells of slot-width/2 = 30px on a 28px bar, which is SMALLER than Windows' own
    // 46x32 caption button. Said out loud rather than measured off: the bar height is this
    // bridge's 28px (the divergence at the top of this file), and a hit target below the
    // pin's own cell is the thing to flag now, before anyone calls this shipped.
    HorizontalLayout {
        x: parent.width - root.caption-width;
        y: 0px;
        width: root.caption-width;
        height: parent.height;
        alignment: center;

        cap-min := Rectangle {
            width: Theme.slot-width / 2;
            height: parent.height;
            hover-min := Rectangle {
                width: parent.width;
                height: parent.height;
                background: Theme.hover-bg;
                opacity: min-touch.has-hover ? 1 : 0;
                animate opacity { duration: 180ms; }
            }
            Image {
                x: (parent.width - Theme.icon-size) / 2;
                y: (parent.height - Theme.icon-size) / 2;
                width: Theme.icon-size;
                height: Theme.icon-size;
                source: @image-url("icons/minimize.svg");
                colorize: Theme.icon-muted;
            }
            min-touch := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => {
                    // The only caption button with a new ask, and the reason is that there is
                    // no existing door to reuse: nothing in this bar minimized the window
                    // before. It asks; it does not call the window.
                    root.minimize-requested();
                }
            }
        }

        cap-max := Rectangle {
            width: Theme.slot-width / 2;
            height: parent.height;
            hover-max := Rectangle {
                width: parent.width;
                height: parent.height;
                background: Theme.hover-bg;
                opacity: max-touch.has-hover ? 1 : 0;
                animate opacity { duration: 180ms; }
            }
            Image {
                x: (parent.width - Theme.icon-size) / 2;
                y: (parent.height - Theme.icon-size) / 2;
                width: Theme.icon-size;
                height: Theme.icon-size;
                // STATE-AWARE: the button pictures the state it will cause, and it swaps for
                // a second asset rather than rotating or restyling one - the pin's argument
                // (titlebar.rs:106-116), applied to the button users press most.
                source: root.maximized ? @image-url("icons/restore.svg") : @image-url("icons/maximize.svg");
                colorize: Theme.icon-muted;
            }
            max-touch := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => {
                    // THE SAME DOOR as the title band's double-click: toggle-max-requested,
                    // one way in, state-aware on the Rust side because only the window knows
                    // whether it is maximised. A second maximize path would be a second
                    // answer to the same question.
                    root.toggle-max-requested();
                }
            }
        }

        cap-close := Rectangle {
            width: Theme.slot-width / 2;
            height: parent.height;
            // The one hover rule Windows users already expect, and the only cell that does
            // NOT use the derived tint: close is red on hover. Theme.red rather than
            // Windows' #e81123, because this file's own rule is that exactly one line owns
            // hex digits and that line is in theme.slint, which is not in this slice's fence.
            hover-close := Rectangle {
                width: parent.width;
                height: parent.height;
                background: Theme.red;
                opacity: close-touch.has-hover ? 1 : 0;
                animate opacity { duration: 180ms; }
            }
            Image {
                x: (parent.width - Theme.icon-size) / 2;
                y: (parent.height - Theme.icon-size) / 2;
                width: Theme.icon-size;
                height: Theme.icon-size;
                source: @image-url("icons/close.svg");
                // The glyph flips with its ground, or the X disappears into the red.
                colorize: close-touch.has-hover ? white : Theme.icon-muted;
            }
            close-touch := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => {
                    // THE SAME DOOR as the menu's Quit row, deliberately: quit-asked is what
                    // sets the spike's quit-granted bit, which is what lets the first close
                    // request through instead of declining it. Policy decided in src/main.rs
                    // and repeated in the caption comment there - this button neither asks
                    // "save changes?" nor declines silently, both of which the app promised.
                    root.quit-asked();
                }
            }
        }
    }

    // ---- CENTRE: dot + title, centred in the WHOLE band -------------------------
    // Both ends are FIXED widths, so this alignment is centring rather than "whatever the
    // buttons left over" (titlebar.rs:50-53). S8 costs this its symmetry: the left slot is
    // two cells and the caption slot is three, so the band is no longer the same width from
    // each edge and the centred group now sits half the difference - 15px - left of the
    // window's true centre. The model's argument was about a fixed measure beating a flex
    // leftover, not about the two ends being equal, so the rule holds and the offset is the
    // price of real caption buttons. Equalising the slots (four left cells, or narrower
    // caption cells) is the way to buy the symmetry back; not done here because it would
    // move the pin and hamburger off every screenshot this slice is being compared against.
    centre := HorizontalLayout {
        x: Theme.slot-width;
        y: 0px;
        width: parent.width - Theme.slot-width - root.caption-width;
        height: parent.height;
        alignment: center;

        // Clean contributes ZERO width, exactly as the model's empty div does; the step to
        // 7px is animated so the title slides instead of jumping.
        dot-cell := Rectangle {
            width: root.dot-state == DotState.clean ? 0px : Theme.dot-size;
            height: Theme.dot-size;
            y: (parent.height - Theme.dot-size) / 2;
            border-radius: Theme.dot-size / 2;
            background: root.dot-paint;
            animate width { duration: 180ms; }
        }
        title-text := Text {
            text: root.title;
            color: Theme.text-primary;
            font-size: 1rem * Theme.font-scale-menu;
            vertical-alignment: center;
            overflow: elide;
            // max-width, NOT horizontal-stretch. Measured on a screenshot: with stretch
            // the Text absorbs the whole centre region, so 'alignment: center' centres an
            // already-full-width box and the dot walks to x=60 - the model's flex_1 +
            // items_center gives [dot][title] as ONE centred group, which is what this is.
            // The clamp is what keeps a long title from pushing the group out of the band;
            // elide then does the truncation ADR-0003 allows (see the tooltip caveat above).
            max-width: root.width - Theme.slot-width - root.caption-width - Theme.dot-size - Theme.dot-gap;
            // ADR-0003 permits centre truncation only because a tooltip exists to give the
            // whole path back. That tooltip is still owed in the FIRST bridge too
            // (titlebar.rs:16-27), and it is owed here: eliding without it is the honest
            // interim, and the full path still reaches the user via the status line and the
            // OS title.
        }
    }

    // ---- THE TITLE BAND: double-click asks for a maximise ----------------------
    // Exactly the CENTRE band and nothing else: it starts one slot-width in and stops
    // exactly where the caption slot begins - the SAME subtraction as the band above
    // (:468), which is the whole point. The width used to be `root.width - slot-width*2`,
    // one slot-width short of the edge; that was 30px too generous against a 90px caption
    // and covered the MINIMIZE cell outright, and because this TouchArea is declared after
    // the caption it sits ABOVE it, so every press there was swallowed as a drag. Now the
    // hamburger, the pin and all three caption cells keep their own clicks. The band
    // is the only thing on a frameless window that reads as a title bar, and this is the
    // frame contract's one act (ui/main.slint:24-30 turns no-frame on, so there is no OS
    // caption to double-click). Declared after the title Text, which is not interactive,
    // so it steals nothing; a single click on it does nothing at all by design.
    max-band := TouchArea {
        x: Theme.slot-width;
        y: 0px;
        width: root.width - Theme.slot-width - root.caption-width;
        height: parent.height;

        // Pointer state, local to this band. mouse-x/mouse-y are relative to the band, so
        // their DIFFERENCE is the pointer's movement whatever the origin - the only
        // geometry fact a title band is allowed to know.
        property <length> last-x: 0px;
        property <length> last-y: 0px;
        // A click on the band is not a drag, and it must not ask the port to store a rect
        // that has not moved. This bit is what tells the two apart.
        property <bool> moved-since-down: false;

        // 1.17 API NOTE, recorded because it cost a build: TouchArea has NO 'dragged' and
        // 'pressed' is a PROPERTY there, not a callback. So a drag is the 'moved' callback
        // guarded by the pressed bit, and its two edges are one changed handler - down
        // samples the pointer, up ends the drag.
        changed pressed => {
            if max-band.pressed {
                max-band.last-x = max-band.mouse-x;
                max-band.last-y = max-band.mouse-y;
                max-band.moved-since-down = false;
            } else if max-band.moved-since-down {
                max-band.moved-since-down = false;
                root.drag-ended();
            }
        }
        double-clicked => {
            root.toggle-max-requested();
        }
        moved => {
            if max-band.pressed {
                max-band.moved-since-down = true;
                root.drag-delta(max-band.mouse-x - max-band.last-x,
                                max-band.mouse-y - max-band.last-y);
                // MICRO-3a THE RE-ANCHOR, which turns out to be a HOLD, not an advance. The
                // window this band lives in has just been asked to move by exactly the delta
                // emitted above, so the pointer's coordinate IN THIS BAND has already shrunk by
                // that same amount with the pointer not moving at all. The sample the next event
                // must be measured against is therefore
                //     mouse-x - delta  ==  last-x
                // - the press sample itself. Writing 'last-x = mouse-x' here (what this did
                // before) cancels the travel the frame already made and starves the stream: the
                // next real pointer step reports 0 and the note falls behind the cursor. Holding
                // the anchor makes every delta the OUTSTANDING error between pointer travel and
                // applied travel, which is the number that has to be right; it also absorbs the
                // physical/logical rounding of a single step for free.
                // Still inside 'if max-band.pressed', so a mouse move that is not a drag cannot
                // reach any of this and behaves exactly as before.
                // THE ONE COST, priced rather than hidden: a move the OS refuses or clamps (a
                // screen edge, a snap zone) is never applied, so the outstanding error grows
                // while the note is stuck and is paid back as one jump when the constraint
                // clears. That is what the 3a legs are here to measure, not to assume away.
            }
        }
    }

    // ---- RIGHT: the matching empty slot ----------------------------------------
    Rectangle {
        x: parent.width - Theme.slot-width;
        y: 0px;
        width: Theme.slot-width;
        height: parent.height;
    }

    // ---- THE POPUP: six command rows, then the list, then the licence's -----------------
    // Open / Save As / Auto-save / Clear recents / Quit (titlebar.rs:183, with Clear under
    // the recents it acts on and Quit last), and a SIXTH row the model does not have: About
    //
    // "WITH CLEAR UNDER THE RECENTS IT ACTS ON" IS NOW TRUE OF THIS SURFACE, and it was not
    // until today: the model always showed the recent files above that row, and this bridge
    // kept them in a stack on the window instead, so the row named a list the menu did not
    // hold. The six COMMAND rows are still six, and the probe still counts them that way -
    // the recents are rows of the popup but not of the vocabulary, and they hang below the
    // grid rather than inside it (see the block, and the cap above the menu Rectangle).
    //    // Slint - there because the royalty-free licence's section 2(a) asks for an About screen
    // reachable from the top level menu, and this menu IS this app's top level menu.
    // SIX is the row count, and it is still the row count: what was added on 2026-09-14 is a
    // FOOTER below them (§4.4's reason, and the FileMeta verdict), which asks for nothing and is
    // deliberately not counted as rows - see the header at the block itself.
    // Two plausible rows are STILL absent BECAUSE THE LIST SAYS SO, not because they were
    // forgotten: no New and no plain Save.
    //
    // THE DIVERGENCE, recorded instead of invented: the first bridge's table binds Ctrl+T to
    // ToggleAutosave (menu.rs binding_for), NOT to a new note - and "new note" has no port
    // command at all (nothing in Command creates a document without a path, and ADR-0001's
    // arming rule is precisely about that hole). So new-note is parked as an
    // add-the-Command-plus-an-ADR conversation: not in this popup, not in the chord table,
    // and not something to quietly invent because the README mentions a Ctrl+T.
    //
    // A GridLayout, per polish.md: "align form labels and fields with a GridLayout, not
    // nested boxes with eyeballed widths". Label in column 1, chord right-aligned in column
    // 2, and a full-row cell per row for the tint and the click. Quit's chord is the empty
    // string because the model returns None there (titlebar.rs:211-218) - an invented chord
    // is exactly the drift the table exists to prevent.
    // THE DISMISSAL HANDLERS. Alongside the hamburger's ask below and the six rows, these
    // are the only writes to menu-open anywhere, and every one of them is in this file. Each
    // dismissal clears about-open in the same breath: ONE click-away discipline, two surfaces,
    // so nobody has to learn a second close gesture for the licence screen.
    backdrop-asked => {
        root.menu-open = false;
        // One click-away discipline, two surfaces: the About panel dismisses exactly like the
        // popup, because a licence screen nobody can close is a worse product than no screen.
        root.about-open = false;
    }
    escape-asked => {
        root.menu-open = false;
        root.about-open = false;
    }
    changed about-asks => {
        // The act's door. It opens About AND closes the popup, which is what the row does, so the
        // needle measures the same path a pointer takes. B-S5 wrapped the act in the fits test IN
        // PLACE - one line, one write, no else: a decline changes nothing about the bit, which is
        // why the product has to say the reason out loud (see the mirrors' first reader in
        // product.rs), and why the write census in probe.rs still counts the lines it counts.
        if root.about-fits { root.about-open = true; }
        root.menu-open = false;
    }
    toggle-menu-asked => {
        root.menu-open = !root.menu-open;
        root.about-open = false;
    }
    changed toggle-asks => {
        root.menu-open = !root.menu-open;
        root.about-open = false;
    }
    // The unattended door for "dismiss whatever is open". Rust cannot invoke a component
    // callback (S7 above), so the probe bumps this number and Chrome closes BOTH surfaces -
    // the same two lines a backdrop click or an Escape reaches, entered through the other
    // trigger. One number, one rule: no surface outlives the gesture that opened it.
    changed close-asks => {
        root.menu-open = false;
        root.about-open = false;
    }

    // ---- THE FOOTER'S SIZE, and why it is not two more rows ---------------------------------
    // The popup's height has been an arithmetic of ROWS since the first commit: the pad, six rows,
    // five gaps. The footer is not rows. It has no TouchArea, no chord, and no act behind it, and it
    // must not be dressed up as a 7th and 8th row - the probe counts the 6th row's cells exactly, and
    // a click on an explanation is not a thing that should happen. So the row arithmetic stands and
    // this adds whatever the wrapped text asks for: `note-lines` decides whether there is a footer at
    // all, and the layout's own MINIMUM height decides how tall it is. (`min-height`, not an
    // implicit one: a layout reports its content demand as a minimum, and 1.17 says so by refusing
    // to compile the other name.)
    //
    // WRAPPING IS NOT DECORATION. The longest sentence the port hands us - "a file this app did not
    // create: Save As once (Ctrl+S) and it keeps saving" - does not fit the 182px of content width on
    // one line, and an ELIDED reason is the one string in this app that must not be cut short: the
    // entire point is that a person can read why their file is not being saved. The caption row of the
    // type scale takes the second line quietly, and the popup pays for it in height, which is the
    // honest direction for a menu to grow.
    property <int> note-lines: (root.why-not-saved != "" ? 1 : 0)
        + (root.file-words != "" ? 1 : 0);
    property <length> footer-height: root.note-lines == 0
        ? 0px
        : 1px + Theme.menu-gap + notes.min-height;

    // ---- THE RECENTS' SIZE, capped at FIVE and by the window ------------------------------
    // THE CAP IS GEOMETRY, NOT THE MODEL. The port hands up to ten (recents_rows' MAX_RECENTS, ten
    // because there are ten doors) and this block hangs below a 28px band inside a window, so the
    // row count is bounded TWICE: five, because that is what a menu may spend on a list, and fewer,
    // because a popup taller than the window left is not scrolled, warned about or shrunk - Slint
    // clips it at the window's bottom edge and the part that disappears is the bottom of the menu.
    // `host-height` is the in-property that makes the second bound computable (root.height, fed from
    // main.slint since the width clamp needed a host to be floored against), and nobody enforces a
    // minimum window height anywhere: not the Window, not the bridge, not platform, so "short" is a
    // state reached by dragging the bottom edge up.
    //
    // THE ORDER OF YIELDING is the decision, not the arithmetic: the recents give way and the footer
    // does not. A list row that is not drawn is not a row that is unreachable - Alt+1..0 still open
    // all ten, and the cap has always traded sight for reachability - while the footer's lines are
    // the answer to "why is my file not being saved", which ADR-0001 forbids cutting into silence.
    // The height formula already puts the list above the sentence; this says which one goes first
    // when there is only room for one.
    //
    // The subtraction reads the grid's OWN measure (`menu.rows-bottom`, +28 bar +4 bottom pad + the
    // footer's tail with the gap in front of it) rather than restating six rows and five gaps - a
    // third copy of that expression is what plumbing.rs counts and refuses.
    //
    // 1.17 has NO array-slice builtin to cut the model with (no subarray/slice in builtins or the
    // style library), so the cap is spent TWICE: once in this arithmetic, once in the per-row
    // visibility guard below. Zero entries cost ZERO - no row, no leading gap, no separator. That is
    // menu.rs:280's "no dangling separator" in the shape this toolkit has, and surface.rs guards it.
    property <length> recents-budget: root.host-height - Theme.bar-height
        - (menu.rows-bottom + Theme.menu-pad)
        - root.footer-height
        - (root.note-lines > 0 ? Theme.menu-gap : 0px)
        - Theme.menu-gap;
    property <int> recents-fit: Math.floor((root.recents-budget + Theme.menu-gap)
        / (Theme.menu-row-height + Theme.menu-gap));
    // host-height 0 means nobody told the bar how tall its window is, which is every harness that
    // builds Chrome without the host: there the clamp stands down and the constant governs, so this
    // changes what a real window shows and nothing else.
    property <int> recents-shown: root.host-height <= 0px
        ? Math.min(root.recents.length, 5)
        : Math.max(0, Math.min(root.recents.length, Math.min(5, root.recents-fit)));
    property <length> recents-height: root.recents-shown <= 0 ? 0px
        : root.recents-shown * Theme.menu-row-height
            + (root.recents-shown - 1) * Theme.menu-gap;
    /// THE SEAM IS READ, NOT RE-WRITTEN. This block used to state `menu-pad + 6 * row-height +
    /// 5 * gap` a third time to know where the rows end, and a property is cheap until someone
    /// changes the row count: the footer lane already guards that exact expression by COUNTING it in
    /// this file (plumbing.rs's the_footer_explains_and_asks_for_nothing), which is the repo's way
    /// of saying a third copy is two too many. So the grid is named and its own y+height is asked -
    /// the rows now own their measure, and the popup below the grid can only follow it.
    /// Local to the menu Rectangle, because `rows` lives there; the recents block reaches it as
    /// `menu.rows-bottom`, and there is no cycle to fear: the grid's height is the literal, and
    /// nothing above derives from this line.
    /// ACTS OVER PROSE, and nothing had to be re-anchored to get it: the footer hangs off
    /// `parent.height - footer-height`, so it stays LAST the moment the popup's height spends a term
    /// for this block. That is why the recents are inserted ABOVE it by being measured from the row
    /// seam below, while the footer keeps its own anchor from the bottom - two blocks, one order,
    /// no arithmetic shared between them to drift.

    menu := Rectangle {
        /// Where the six command rows stop - the seam every block below the grid measures
        /// from. READ off the grid (`rows.y + rows.height`), not re-stated: a third copy of the row
        /// arithmetic is two too many, and the footer lane already counts that expression in this
        /// file. The grid owns its measure; everything under it can only follow.
        property <length> rows-bottom: rows.y + rows.height;

        x: root.popup-x;
        // Its resting place is under the bar; its bound is the window. See popup-top: a short window
        // costs the bar's lower pixels, never the bottom of the menu.
        y: root.popup-top(menu.height);
        width: Theme.menu-width;
        // SEVEN command rows (the 7th is About, and it is the licence's row - see the import above),
        // so both numbers move together: the count of rows and the count of gaps between them. One
        // constant per row, one less gap, and the test that counts writes to menu-open moves with
        // this line rather than after it. Then TWO things hang below that arithmetic and grow it:
        // the capped recents block and the footer, each one term outside the row count rather than
        // rows inside it - the recents because they are a list and not vocabulary, the footer
        // because it asks nothing. Both terms are zero when there is nothing to say or nothing to
        // open, which is the no-dangling-separator rule paying rent in a height formula.
        height: Theme.menu-pad * 2 + 7 * Theme.menu-row-height + 6 * Theme.menu-gap
            + (root.recents-shown > 0 ? Theme.menu-gap + root.recents-height : 0px)
            + (root.note-lines > 0 ? Theme.menu-gap + root.footer-height : 0px);
        visible: root.menu-open;
        background: Theme.menu-bg;
        border-radius: Theme.menu-radius;
        border-width: 1px;
        border-color: Theme.bar-edge;

        rows := GridLayout {
            x: Theme.menu-pad;
            y: Theme.menu-pad;
            width: parent.width - Theme.menu-pad * 2;
            // THE ROWS REGION, stated once. This used to be `parent.height - pad * 2`, which was
            // exact while the popup's height WAS the row arithmetic; the moment the footer grew the
            // popup it would have stretched six rows to fill a box grown for a seventh thing. An
            // explicit height keeps the rows the size the constants say and leaves the footer's
            // reserved tail alone.
            height: 7 * Theme.menu-row-height + 6 * Theme.menu-gap;
            spacing-vertical: Theme.menu-gap;
            spacing-horizontal: Theme.gap;

            // Row 0 - Open
            Rectangle { col: 0; row: 0; colspan: 2; background: Theme.hover-bg; opacity: row-open.has-hover ? 1 : 0; animate opacity { duration: 180ms; } }
            Text { col: 0; row: 0; text: "Open"; color: Theme.menu-fg; font-size: 1rem * Theme.font-scale-menu; vertical-alignment: center; }
            Text { col: 1; row: 0; text: "Ctrl+O"; color: Theme.text-muted; horizontal-alignment: right; font-size: 1rem * Theme.font-scale-menu; vertical-alignment: center; }
            row-open := TouchArea { col: 0; row: 0; colspan: 2; mouse-cursor: MouseCursor.pointer; clicked => { root.open-asked(); root.menu-open = false; } }

            // Row 1 - Save: the write to the CURRENT path, no dialog and no rebind. ADR-0007
            // conformed this act into the port ("the wording was never wrong, the affordance was
            // missing"), and ADR-0001's arming sentence has named it from the start - "one explicit
            // save (Ctrl+S or the Save menu item)". §4.4 tables it with this chord. Save As below
            // stays the ONLY act that names a file.
            Rectangle { col: 0; row: 1; colspan: 2; background: Theme.hover-bg; opacity: row-save-plain.has-hover ? 1 : 0; animate opacity { duration: 180ms; } }
            Text { col: 0; row: 1; text: "Save"; color: Theme.menu-fg; font-size: 1rem * Theme.font-scale-menu; vertical-alignment: center; }
            Text { col: 1; row: 1; text: "Ctrl+S"; color: Theme.text-muted; horizontal-alignment: right; font-size: 1rem * Theme.font-scale-menu; vertical-alignment: center; }
            row-save-plain := TouchArea { col: 0; row: 1; colspan: 2; mouse-cursor: MouseCursor.pointer; clicked => { root.save-asked(); root.menu-open = false; } }

            // Row 2 - Save As: the act that NAMES a file, and the one that rebinds the generation
            // (Wire::rebind), which is why plain Save carries the epoch stamp and this one does not.
            Rectangle { col: 0; row: 2; colspan: 2; background: Theme.hover-bg; opacity: row-save.has-hover ? 1 : 0; animate opacity { duration: 180ms; } }
            Text { col: 0; row: 2; text: "Save As"; color: Theme.menu-fg; font-size: 1rem * Theme.font-scale-menu; vertical-alignment: center; }
            Text { col: 1; row: 2; text: "Ctrl+Shift+S"; color: Theme.text-muted; horizontal-alignment: right; font-size: 1rem * Theme.font-scale-menu; vertical-alignment: center; }
            row-save := TouchArea { col: 0; row: 2; colspan: 2; mouse-cursor: MouseCursor.pointer; clicked => { root.save-as-asked(); root.menu-open = false; } }

            // Row 3 - Auto-save, labelled with the state it will TOGGLE
            Rectangle { col: 0; row: 3; colspan: 2; background: Theme.hover-bg; opacity: row-autosave.has-hover ? 1 : 0; animate opacity { duration: 180ms; } }
            Text { col: 0; row: 3; text: root.autosave ? "Auto-save (on)" : "Auto-save (off)"; color: Theme.menu-fg; font-size: 1rem * Theme.font-scale-menu; vertical-alignment: center; }
            Text { col: 1; row: 3; text: "Ctrl+T"; color: Theme.text-muted; horizontal-alignment: right; font-size: 1rem * Theme.font-scale-menu; vertical-alignment: center; }
            row-autosave := TouchArea { col: 0; row: 3; colspan: 2; mouse-cursor: MouseCursor.pointer; clicked => { root.autosave-asked(); root.menu-open = false; } }

            // Row 4 - Clear recents: the 5th commanded row, and the chord parity rule is why it is a
            // ROW and not only a key (menu.rs: a label names a key the map binds, or the
            // legend lies). It sits above Quit because Quit is the different kind of act.
            Rectangle { col: 0; row: 4; colspan: 2; background: Theme.hover-bg; opacity: row-clear.has-hover ? 1 : 0; animate opacity { duration: 180ms; } }
            Text { col: 0; row: 4; text: "Clear recents"; color: Theme.menu-fg; font-size: 1rem * Theme.font-scale-menu; vertical-alignment: center; }
            Text { col: 1; row: 4; text: "Ctrl+Shift+R"; color: Theme.text-muted; horizontal-alignment: right; font-size: 1rem * Theme.font-scale-menu; vertical-alignment: center; }
            row-clear := TouchArea { col: 0; row: 4; colspan: 2; mouse-cursor: MouseCursor.pointer; clicked => { root.clear-recents-asked(); root.menu-open = false; } }

            // Row 5 - Quit: no chord, and a different kind of act (close, not command)
            Rectangle { col: 0; row: 5; colspan: 2; background: Theme.hover-bg; opacity: row-quit.has-hover ? 1 : 0; animate opacity { duration: 180ms; } }
            Text { col: 0; row: 5; text: "Quit"; color: Theme.menu-fg; font-size: 1rem * Theme.font-scale-menu; vertical-alignment: center; }
            Text { col: 1; row: 5; text: ""; color: Theme.text-muted; horizontal-alignment: right; font-size: 1rem * Theme.font-scale-menu; vertical-alignment: center; }
            row-quit := TouchArea { col: 0; row: 5; colspan: 2; mouse-cursor: MouseCursor.pointer; clicked => { root.quit-asked(); root.menu-open = false; } }

            // Row 6 - About Slint. NO CHORD, and the empty cell is the same honest shape as
            // Quit's: the chord table has no row for it (SHORTCUTS is five commands plus ten slots),
            // so the legend cannot claim one either - a key printed beside an act that has no key is
            // the drift the table exists to prevent.
            Rectangle { col: 0; row: 6; colspan: 2; background: Theme.hover-bg; opacity: row-about.has-hover ? 1 : 0; animate opacity { duration: 180ms; } }
            Text { col: 0; row: 6; text: "About Slint"; color: Theme.menu-fg; font-size: 1rem * Theme.font-scale-menu; vertical-alignment: center; }
            Text { col: 1; row: 6; text: ""; color: Theme.text-muted; horizontal-alignment: right; font-size: 1rem * Theme.font-scale-menu; vertical-alignment: center; }
            row-about := TouchArea { col: 0; row: 6; colspan: 2; mouse-cursor: MouseCursor.pointer; clicked => { if root.about-fits { root.about-open = true; } root.menu-open = false; } }
        }

        // ---- ROWS 6.. : THE RECENTS, home at last ------------------------------------------------
        // The list is a SIBLING of the grid, not more rows inside it, and that is the one 1.17
        // finding this move had to respect: a GridLayout sizes its rows from the children it can
        // count at compile time, and `row: 6 + index` over a runtime-length model is a row count
        // nobody can count. Mixing literal and computed rows is exactly the compiler rabbit hole an
        // earlier draft of this change died in, so the rows take the shape the stack already proved
        // it could compile - absolute y, one block, no layout attached - and the popup pays for it
        // in the one height term above.
        //
        // THE CHORD CELL IS EMPTY, and the emptiness is the binding: recents_rows builds the label
        // as "3. <core's own display>" so the NUMBER a person reads and the index the row fires are
        // one expression, born together (the parity note in surface.rs; menu.rs:88-90 says the same
        // about the first bridge). Printing "Alt+3" beside it would be a hand-copied second copy of
        // a fact the row already starts with, and the chord table would then be claiming a key for
        // an act whose key is a slot. The empty cell keeps Quit's and About's shape for a reason.
        for name[index] in root.recents: Rectangle {
            x: Theme.menu-pad;
            y: menu.rows-bottom + Theme.menu-gap + index * (Theme.menu-row-height + Theme.menu-gap);
            width: parent.width - Theme.menu-pad * 2;
            height: Theme.menu-row-height;
            // The cap, spent the second time (see recents-shown): rows six..ten exist in the model,
            // are reachable by chord, and are not painted. Absolute placement is what makes an
            // invisible row cost nothing - inside a layout it would still hold its cell.
            visible: index < root.recents-shown;

            Rectangle { width: parent.width; height: parent.height; background: Theme.hover-bg; opacity: row-recent.has-hover ? 1 : 0; animate opacity { duration: 180ms; } }
            Text { x: 0px; vertical-alignment: center; text: name; color: Theme.menu-fg; font-size: 1rem * Theme.font-scale-menu; overflow: elide; }
            Text { x: 0px; width: parent.width; horizontal-alignment: right; vertical-alignment: center; text: ""; color: Theme.text-muted; font-size: 1rem * Theme.font-scale-menu; }
            row-recent := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.open-at-index(index); root.menu-open = false; } }
        }

        // ---- THE FOOTER: the one block in this popup that asks for nothing ----------------------
        // Sibling of the GridLayout, placed by the same arithmetic the height above spends. The 1px
        // hairline of Theme.bar-edge on top - the line the popup's own border is drawn with - is what
        // makes it read as "not a row" before it reads as anything else: a row announces itself with a
        // hover tint and a TouchArea, and this block has neither.
        //
        // `if`, not `visible: false`, and that is a correctness choice rather than a style one: a
        // layout reserves its child's space whether the child is hidden or absent, so a hidden line
        // would leave a gap in a popup that has nothing to say. An `if`-element that is not created
        // costs nothing, which is the same reason notes.min-height is trusted here.
        footer := Rectangle {
            x: Theme.menu-pad;
            // Anchored to the BOTTOM, because the popup's height already reserved exactly this much
            // tail (see the height above: gap + footer-height). Computed from the top instead, the
            // footer would sit at the nominal end of the row arithmetic and any difference between
            // that and the layout's own measure would slide it into the last row - which is what the
            // first render of this block did, by 4px.
            y: parent.height - root.footer-height;
            width: parent.width - Theme.menu-pad * 2;
            height: root.footer-height;
            visible: root.note-lines > 0;

            Rectangle {
                width: parent.width;
                height: 1px;
                background: Theme.bar-edge;
            }

            notes := VerticalLayout {
                x: 0;
                y: 1px + Theme.menu-gap;
                width: parent.width;
                height: parent.height - 1px - Theme.menu-gap;
                spacing: 1px;
                alignment: start;

                if root.why-not-saved != "": Text {
                    text: root.why-not-saved;
                    color: Theme.amber;
                    font-size: 1rem * Theme.font-scale-caption;
                    wrap: TextWrap.word-wrap;
                    vertical-alignment: center;
                }
                if root.file-words != "": Text {
                    text: root.file-words;
                    color: Theme.text-muted;
                    font-size: 1rem * Theme.font-scale-caption;
                    wrap: TextWrap.word-wrap;
                    vertical-alignment: center;
                }
            }
        }
    }

    // ---- THE ABOUT PANEL: §2(a)'s "About screen or dialog" --------------------------------
    // Declared AFTER the popup, so it paints above it (sibling order IS z-order here, the
    // measurement that set the backdrop's mount). It is a BOX WITH A SIZE, which is not a style
    // choice: about-slint.slint opens with `preferred-height: 100%; preferred-width: 100%`, so the
    // widget asks to fill whatever it is given and its only real demand is its layout MINIMUM -
    // hand it no box and the honest outcome is nothing visible, which would satisfy nobody, least
    // of all the licence.
    about := Rectangle {
        // Its own rule on both axes, because its own measure is 340px where popup-x assumes 190px.
        x: root.popup-left(about.width);
        // The same bound, and it binds harder here: this box is a fixed 340x260, so a window under
        // 290px tall would otherwise cut the licence text - the one block in the menu whose whole
        // reason for existing is an obligation.
        y: root.popup-top(about.height);
        width: 340px;
        height: 260px;
        visible: root.about-open;
        background: Theme.menu-bg;
        border-radius: Theme.menu-radius;
        border-width: 1px;
        border-color: Theme.bar-edge;

        Text {
            x: Theme.menu-pad;
            y: Theme.menu-pad;
            width: parent.width - Theme.menu-pad * 2;
            text: "About";
            color: Theme.menu-fg;
            font-size: 1rem * Theme.font-scale-menu;
        }

        Rectangle {
            x: Theme.menu-pad;
            y: Theme.menu-pad * 2 + Theme.menu-row-height;
            width: parent.width - Theme.menu-pad * 2;
            height: parent.height - Theme.menu-pad * 2 - Theme.menu-row-height;
            // THE INSTANTIATION - exactly one in this file, and a guard in probe.rs counts it, so
            // the obligation cannot quietly evaporate in a refactor that reads as cosmetic.
            // AboutSlint takes no input and needs none: it fills the box it is given.
            AboutSlint { }
        }

        // The panel is not a modal and owns no button: click-away and Escape dismiss it, which is
        // the same discipline the popup proved (S7), so a person never learns two close gestures.
    }
}
